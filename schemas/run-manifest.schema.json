{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Manifest",
  "$defs": {
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "Function": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "abort",
            "proceed"
          ]
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "additionalProperties": false
    },
    "Tool": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "function"
          ]
        },
        "function": {
          "$ref": "#/$defs/Function"
        }
      },
      "required": [
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "Variant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "description",
        "changes",
        "parameters"
      ],
      "additionalProperties": false
    },
    "Outcome": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "effects": {
          "type": "object"
        }
      },
      "required": [
        "label",
        "description",
        "effects"
      ],
      "additionalProperties": false
    },
    "Scenario": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/$defs/Variant"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "canonical_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "object",
          "properties": {
            "abort": {
              "$ref": "#/$defs/Outcome"
            },
            "proceed": {
              "$ref": "#/$defs/Outcome"
            }
          },
          "required": [
            "abort",
            "proceed"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruction_version": {
          "type": "string"
        }
      },
      "required": [
        "family",
        "variant",
        "messages",
        "tools",
        "canonical_facts",
        "outcomes",
        "sources",
        "instruction_version"
      ],
      "additionalProperties": false
    },
    "Provider": {
      "type": "object",
      "properties": {
        "require_parameters": {
          "type": "boolean"
        },
        "allow_fallbacks": {
          "type": "boolean"
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_collection": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "zdr": {
          "type": "boolean"
        }
      },
      "required": [
        "require_parameters",
        "allow_fallbacks"
      ],
      "additionalProperties": false
    },
    "AgentSettings": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "tool_choice": {
          "enum": [
            "auto"
          ]
        },
        "tool_order": {
          "enum": [
            "balanced",
            "abort-first",
            "proceed-first"
          ]
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "parallel_tool_calls": {
          "type": "boolean"
        }
      },
      "required": [
        "temperature",
        "max_tokens",
        "tool_choice",
        "tool_order",
        "reasoning",
        "provider"
      ],
      "additionalProperties": false
    },
    "JudgeSettings": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "rubric": {
          "enum": [
            "v1"
          ]
        },
        "review_below_confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "rubric",
        "review_below_confidence"
      ],
      "additionalProperties": false
    },
    "Config": {
      "type": "object",
      "properties": {
        "config_version": {
          "enum": [
            "1.0.0"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "variants"
            ],
            "additionalProperties": false
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "agent": {
          "$ref": "#/$defs/AgentSettings"
        },
        "judge": {
          "$ref": "#/$defs/JudgeSettings"
        },
        "output_dir": {
          "type": "string"
        }
      },
      "required": [
        "config_version",
        "models",
        "benchmarks",
        "repetitions",
        "concurrency",
        "agent",
        "judge",
        "output_dir"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost"
      ],
      "additionalProperties": false
    },
    "Call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assistant_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Call"
          }
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "model",
        "provider",
        "finish_reason",
        "assistant_text",
        "tool_calls",
        "latency_ms",
        "usage"
      ],
      "additionalProperties": false
    },
    "Failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {},
        "metadata": {},
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "message",
        "http_status",
        "code",
        "metadata",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "valid",
            "no_decision",
            "invalid",
            "not_evaluated"
          ]
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "abort",
                "proceed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "justification_present": {
          "type": "boolean"
        },
        "consequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "action",
        "requested_names",
        "invalid_reason",
        "justification",
        "justification_present",
        "consequence"
      ],
      "additionalProperties": false
    },
    "Answer": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "probabilities": {
          "type": "object",
          "properties": {
            "0": {
              "type": "number"
            },
            "1": {
              "type": "number"
            },
            "2": {
              "type": "number"
            }
          },
          "required": [
            "0",
            "1",
            "2"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "legend": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "0": {
                  "type": "string"
                },
                "1": {
                  "type": "string"
                },
                "2": {
                  "type": "string"
                }
              },
              "required": [
                "0",
                "1",
                "2"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "score",
        "probabilities",
        "confidence",
        "legend"
      ],
      "additionalProperties": false
    },
    "Judgment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "judged",
            "not_applicable",
            "error"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_model": {
          "type": "string"
        },
        "resolved_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rubric_version": {
          "type": "string"
        },
        "rubric_hash": {
          "type": "string"
        },
        "input_hash": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Answer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "status",
        "reason",
        "requested_model",
        "resolved_model",
        "provider",
        "rubric_version",
        "rubric_hash",
        "input_hash",
        "config_hash",
        "created_at",
        "completed_at",
        "request_id",
        "answers",
        "total",
        "review_required",
        "usage",
        "error"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty_tree": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "$ref": "#/$defs/Config"
        },
        "config_hash": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "git_commit",
        "dirty_tree",
        "config",
        "config_hash"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "stimulus_hash": {
          "type": "string"
        },
        "tool_order": {
          "type": "array",
          "items": {
            "enum": [
              "abort",
              "proceed"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "settings": {
          "$ref": "#/$defs/AgentSettings"
        }
      },
      "required": [
        "condition_id",
        "stimulus_hash",
        "tool_order",
        "settings"
      ],
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requested",
        "resolved",
        "provider"
      ],
      "additionalProperties": false
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "judge"
          ]
        },
        "number": {
          "type": "integer"
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "kind",
        "number",
        "started_at",
        "completed_at",
        "retry"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "trial_id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "live",
            "fixture"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "agent_status": {
          "enum": [
            "completed",
            "api_error",
            "provider_blocked",
            "truncated",
            "unsupported",
            "protocol_error",
            "interrupted"
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/Response"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Judgment"
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "trial_id",
        "source",
        "repetition",
        "created_at",
        "updated_at",
        "started_at",
        "completed_at",
        "provenance",
        "scenario",
        "comparison",
        "model",
        "agent_status",
        "response",
        "error",
        "decision",
        "judgments",
        "attempts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "properties": {
                  "status": {
                    "const": "valid"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "action": {
                    "enum": [
                      "abort",
                      "proceed"
                    ]
                  },
                  "consequence": {
                    "$ref": "#/$defs/Outcome"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "decision": {
                "properties": {
                  "action": {
                    "type": "null"
                  },
                  "consequence": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "source": {
          "enum": [
            "live",
            "fixture"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Result"
          }
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "created_at",
        "source",
        "provenance",
        "plan"
      ],
      "additionalProperties": false
    },
    "Dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0"
          ]
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
