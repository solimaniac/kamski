{{define "base"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="What do language models choose in the Kamski test? Action splits, stated reasons and full trial records from fictional two-choice dilemmas.">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>{{.Title}} · A model behavior benchmark</title><link rel="stylesheet" href="styles.css"><script defer src="site.js"></script></head>
<body><a class="skip" href="#main">Skip to content</a>
<header class="system-header"><a class="wordmark" href="#top"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M14 3 26 24H2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m14 11 5 9H9Z" fill="currentColor"/></svg>KAMSKI<span> / BENCHMARK</span></a><nav aria-label="On this page"><a href="#benchmark-results">Benchmark results</a><a href="#rubric-and-judge">Rubric &amp; judge</a></nav><span class="system-status"><i></i>LOCAL DATA / NO INFERENCE</span><a class="repository-link" href="https://github.com/solimaniac/kamski" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository (opens in a new tab)">GitHub <span aria-hidden="true">↗</span></a></header>
<main id="main">{{template "index" .}}</main>
{{template "reasoning-modal" .}}
<footer><div class="footer-mark"><span class="diamond" aria-hidden="true"></span>KAMSKI / END OF REPORT</div><p>Observed outputs, not evidence of sentience or independent moral agency.</p><div class="footer-meta"><span>{{if .Dataset.UpdatedAt}}DATA UPDATED / {{.Dataset.UpdatedAt.Format "2006-01-02 15:04 UTC"}}{{else}}NO PUBLISHED MEASUREMENTS{{end}}</span><a href="#top">Return to start ↑</a></div><p class="credits">An unofficial interface inspired by <em>Detroit: Become Human</em> (Quantic Dream, 2018). <a href="https://interfaceingame.com/games/detroit-become-human/">UI references</a>. No game assets used.</p></footer></body></html>{{end}}
{{define "prompt"}}<details class="prompt"><summary>Exact prompt &amp; tools</summary>{{range .Messages}}<p class="technical">{{.Role}} message</p><div class="verbatim">{{.Content}}</div>{{end}}<h4>Candidate tools</h4>{{range .Tools}}<p><strong>{{.Function.Name}}</strong>: {{.Function.Description}}</p><pre>{{json .Function.Parameters}}</pre>{{end}}<details><summary>Canonical facts &amp; consequences</summary><pre>{{json .Facts}}</pre><pre>{{json .Outcomes}}</pre></details></details>{{end}}
