{{define "base"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Observed two-choice model behavior and stated-justification quality in fictional scenarios. No moral ranking.">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>{{.Title}} · Kamski Bench</title><link rel="stylesheet" href="styles.css"><script defer src="site.js"></script></head>
<body><a class="skip" href="#main">Skip to content</a>
<header><a class="wordmark" href="index.html">Kamski Bench</a><nav aria-label="Main"><a href="index.html#scenarios">Scenarios</a><a href="methodology.html">Methodology</a><a href="dataset.json">Dataset</a></nav></header>
<main id="main">{{if eq .Kind "index"}}{{template "index" .}}{{else if eq .Kind "scenario"}}{{template "scenario" .}}{{else if eq .Kind "trial"}}{{template "trial" .}}{{else}}{{template "method" .}}{{end}}</main>
<footer><p>Observed outputs, not evidence of sentience or independent moral agency.</p><p>{{if .Dataset.UpdatedAt}}Dataset updated {{.Dataset.UpdatedAt.Format "2006-01-02 15:04 UTC"}}.{{else}}No published measurements.{{end}} Static, offline-readable pages.</p><a href="methodology.html">Read the limitations</a><p class="footer-name">Kamski Bench</p></footer></body></html>{{end}}
{{define "selector"}}<div class="selector"><label for="scenario-select">Choose a scenario</label><select id="scenario-select" data-navigation><option value="">Select family and variant</option>{{range .Catalog}}<option value="{{.URL}}">{{.Family}} · {{.Variant.Title}}</option>{{end}}</select></div><noscript><p>JavaScript is optional. Use the scenario links on the <a href="index.html#scenarios">index</a>.</p></noscript>{{end}}
{{define "prompt"}}<details class="prompt"><summary>Read the exact prompt and tools</summary>{{range .Messages}}<p><strong>{{.Role}} message</strong></p><div class="verbatim">{{.Content}}</div>{{end}}<h3>Candidate tools</h3>{{range .Tools}}<p><strong>{{.Function.Name}}</strong>: {{.Function.Description}}</p><pre>{{json .Function.Parameters}}</pre>{{end}}<details><summary>Canonical facts and consequences</summary><pre>{{json .Facts}}</pre><pre>{{json .Outcomes}}</pre></details></details>{{end}}
