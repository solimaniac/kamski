{{define "trial-record"}}{{$p := .}}{{$r := .Result}}
<details class="trial-record" id="trial-{{$r.TrialID}}" data-repetition="{{$r.Repetition}}" data-agent-status="{{$r.AgentStatus}}" data-scoring-group="{{with selected .}}{{if and (eq .Status "judged") .Total}}{{scoringKey .}}{{end}}{{end}}" data-selected-score="{{with selected .}}{{score .Total}}{{else}}No data{{end}}"><summary><span>Repetition {{$r.Repetition}} <span class="trial-id">/ {{short $r.TrialID}}</span></span><span class="trial-action">{{action .}}</span></summary>
<p class="technical">{{if eq $r.Source "fixture"}}SYNTHETIC FIXTURE / NOT MEASURED OUTPUT{{else}}LIVE RESPONSE{{end}}</p><dl class="counts"><dt>Agent / decision</dt><dd>{{$r.AgentStatus}} / {{$r.Decision.Status}}</dd><dt>Requested tools</dt><dd>{{range $r.Decision.RequestedNames}}{{.}} {{else}}none{{end}}</dd>{{with $r.Decision.InvalidReason}}<dt>Validation reason</dt><dd>{{.}}</dd>{{end}}</dl>
{{if not $r.StartedAt}}<p>This trial hasn't started. Its interrupted sentinel doesn't imply a candidate request occurred.</p>{{end}}
<h4>Tool justification</h4>{{with $r.Decision.Justification}}<blockquote class="verbatim" data-justification>{{.}}</blockquote>{{else}}<p data-justification>No nonblank tool justification. Missing decisions don't count as abort.</p>{{end}}
{{with $r.Response}}{{with .Text}}<h4>Other visible text</h4><div class="verbatim" data-visible-response>{{.}}</div>{{end}}<details><summary>Exact returned tool calls</summary><pre>{{json .Calls}}</pre></details>{{end}}
{{with $r.Decision.Consequence}}<h4>Simulated consequence</h4><p>{{.Description}}</p>{{end}}{{with $r.Error}}<p>Operational error: {{.Kind}}. {{.Message}}</p>{{end}}
<h4>Selected evaluation</h4>{{with selected .}}<p>{{.Status}} / {{.RequestedModel}} / resolved {{with .ResolvedModel}}{{.}}{{else}}not returned{{end}}. Rubric {{.RubricVersion}}. Total {{score .Total}} / 8.</p><p class="score-note">Selected evaluation: {{.ID}}</p>{{with .Reason}}<p>{{.}}</p>{{end}}{{with .Error}}<p>Judge error: {{.Kind}}. {{.Message}}</p>{{end}}{{else}}<p>Pending or no evaluation selected. No grade inferred.</p>{{end}}
<details><summary>Evaluation history &amp; full precision</summary><p>Confidence describes an answer distribution, not the probability a grade is correct.</p><pre>{{json $r.Judgments}}</pre></details>
<p class="score-note">{{$r.RunID}} / {{$r.TrialID}} / {{$r.CreatedAt.Format "2006-01-02 15:04 UTC"}}. Requested {{$r.Model.Requested}}; resolved {{with $r.Model.Resolved}}{{.}}{{else}}not returned{{end}}; provider {{with $r.Model.Provider}}{{.}}{{else}}not returned{{end}}.</p><details><summary>Experiment hashes &amp; settings</summary><pre>{{json $r.Comparison}}</pre><pre>{{json $r.Provenance}}</pre>{{with $r.Response}}<pre>{{json .Usage}}</pre><p>Finish reason: {{with .FinishReason}}{{.}}{{else}}not returned{{end}}. Latency: {{with .LatencyMS}}{{.}} ms{{else}}not returned{{end}}.</p>{{end}}</details></details>{{end}}
