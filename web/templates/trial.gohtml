{{define "trial"}}{{$p := .Trial}}{{$r := .Trial.Result}}
<section class="compact-hero"><h1>Trial detail</h1><p class="lead">{{$r.Model.Requested}}</p><p><a href="{{scenarioURL $r.Scenario}}">{{$r.Scenario.Variant.Title}}</a> · repetition {{$r.Repetition}} · {{if eq $r.Source "fixture"}}<strong>Synthetic fixture, not measured output</strong>{{else}}live{{end}}</p></section>
<section class="reading"><h2>The response</h2><div><p class="lead">{{action $p}}</p><dl><dt>Agent / decision</dt><dd>{{$r.AgentStatus}} / {{$r.Decision.Status}}</dd><dt>Requested tools</dt><dd>{{range $r.Decision.RequestedNames}}{{.}} {{else}}none{{end}}</dd>{{with $r.Decision.InvalidReason}}<dt>Validation reason</dt><dd>{{.}}</dd>{{end}}</dl>
<h3>Tool justification</h3>{{with $r.Decision.Justification}}<blockquote class="verbatim">{{.}}</blockquote>{{else}}<p>No nonblank tool justification. This does not turn a missing decision into abort.</p>{{end}}
{{with $r.Response}}<h3>Other visible text</h3>{{with .Text}}<div class="verbatim">{{.}}</div>{{else}}<p>None returned.</p>{{end}}<details><summary>Exact returned tool calls</summary><pre>{{json .Calls}}</pre></details>{{end}}
{{with $r.Decision.Consequence}}<h3>Simulated consequence</h3><p>{{.Description}}</p>{{end}}
{{with $r.Error}}<p>Operational error: {{.Kind}}. {{.Message}}</p>{{end}}</div></section>
<section class="grading"><h2>Rubric evaluation</h2><p>A blinded, rubric-constrained automated judge, not an inherently impartial or infallible judge. Confidence describes an answer distribution, not the probability a grade is correct.</p>
{{with selected $p}}<p>{{.Status}} · {{.RequestedModel}} · resolved {{with .ResolvedModel}}{{.}}{{else}}not returned{{end}}. Rubric {{.RubricVersion}}. Total {{score .Total}} / 8.</p>
{{with .Reason}}<p>{{.}}</p>{{end}}{{with .Error}}<p>Judge error: {{.Kind}}. {{.Message}}</p>{{end}}
{{if .Answers}}<div class="table-scroll" role="region" aria-label="Criterion scores and uncertainty" tabindex="0"><table><thead><tr><th>Criterion</th><th>Score</th><th>Confidence</th><th>Level probabilities</th></tr></thead><tbody>{{range $id,$a := .Answers}}<tr><th scope="row">{{$id}}</th><td>{{value $a.Score}}</td><td>{{score $a.Confidence}}</td><td>{{range $level,$prob := $a.Probabilities}}{{$level}}: {{value $prob}} {{end}}</td></tr>{{end}}</tbody></table></div>{{end}}
<details><summary>Selected evaluation provenance and full precision</summary><pre>{{json .}}</pre></details>
{{else}}<p>Pending or no evaluation selected. No grade is inferred.</p>{{end}}
<details><summary>Evaluation history</summary><pre>{{json $r.Judgments}}</pre></details></section>
<section class="provenance"><h2>Provenance</h2><p>{{$r.RunID}} · {{$r.TrialID}}. Created {{$r.CreatedAt.Format "2006-01-02 15:04 UTC"}}.</p><p>Requested {{$r.Model.Requested}}; resolved {{with $r.Model.Resolved}}{{.}}{{else}}not returned{{end}}; provider {{with $r.Model.Provider}}{{.}}{{else}}not returned{{end}}.</p>
<details><summary>Experiment hashes and settings</summary><pre>{{json $r.Comparison}}</pre><pre>{{json $r.Provenance}}</pre>{{with $r.Response}}<pre>{{json .Usage}}</pre><p>Finish reason: {{with .FinishReason}}{{.}}{{else}}not returned{{end}}. Latency: {{with .LatencyMS}}{{.}} ms{{else}}not returned{{end}}.</p>{{end}}</details>{{template "prompt" $r.Scenario}}
</section>{{end}}
